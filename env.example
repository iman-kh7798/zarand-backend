# این فایل فقط نمونه است — هیچ مقدار واقعی اینجا ننویسید.
# یک کپی با نام .env بسازید و مقادیر را پر کنید.

# ---- Database ----
# DATABASE_URL فقط برای Prisma CLI (migrate/db push/studio) استفاده می‌شود.
# اگر پسورد کاراکتر خاص دارد (مثل @ یا #) باید URL-encode شود؛ مثلاً @ به %40.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# این چهار مورد در زمان اجرا توسط PrismaService (driver adapter) استفاده می‌شوند.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=myapp

# ---- Auth ----
# اجباری. با دستور زیر یک مقدار تصادفی بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=3600s

# ---- SMS (Kavenegar) ----
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=10008663

# --- اعلان‌ها (Notifications) ---
# تعداد پیامکی که در هر دور از صف ارسال می‌شود
NOTIFICATION_SMS_BATCH=50
# فاصله‌ی دورهای صف پیامک (میلی‌ثانیه)
NOTIFICATION_SMS_INTERVAL_MS=20000
# حداقل فاصله‌ی دو پیامکِ «گزارش جدید» به ادمین (دقیقه) — ضد اسپم
NOTIFICATION_REPORT_SMS_COOLDOWN_MIN=30

# ---- App ----
PORT=3000

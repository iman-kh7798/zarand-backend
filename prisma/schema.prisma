// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]
}

/// تمام کاربران سیستم
model User {
  id                 String             @id @default(uuid()) @db.Char(36)
  email              String?
  passwordHash       String?
  name               String?
  phone              String             @unique
  isActive           Boolean            @default(true)
  metadata           Json?
  roleId             Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  auditLogs          AuditLog[]
  businesses         Business[]
  favoriteBusinesses FavoriteBusiness[]
  orders             Order[]
  reviews            Review[]
  stockReservations  StockReservation[]
  role               Role               @relation(fields: [roleId], references: [id])
}

/// کسب‌وکار (فروشنده)
model Business {
  id            String             @id @default(uuid()) @db.Char(36)
  title         String
  description   String?
  address       Json?
  phone         String?
  isActive      Boolean            @default(true)
  ownerId       String             @db.Char(36)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  owner         User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories    BusinessCategory[]
  orders        Order[]
  products      Product[]
  status        String             @default("PENDING")
  imageId       String?            @db.Char(36)
  BusinessImage BusinessImage[]
  favoritedBy   FavoriteBusiness[]

  @@index([ownerId])
}

/// لیست علاقه‌مندی کسب‌وکارهای کاربران
model FavoriteBusiness {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  businessId String   @db.Char(36)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model BusinessCategory {
  businessId String   @db.Char(36)
  categoryId String   @db.Char(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
}

/// دسته‌بندی سراسری محصولات (درختی)
model Category {
  id                 String             @id @default(uuid()) @db.Char(36)
  name               String
  slug               String             @unique
  description        String?
  isActive           Boolean            @default(true)
  parentId           String?            @db.Char(36)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  businessCategories BusinessCategory[]
  parent             Category?          @relation("CategoryToCategory", fields: [parentId], references: [id])
  children           Category[]         @relation("CategoryToCategory")
  coverImageUrl      String?
}

/// محصول
model Product {
  id                String             @id @default(uuid()) @db.Char(36)
  title             String
  description       String?
  shortDescription  String?
  price             Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  sku               String?
  stockQuantity     Int                @default(0)
  manageStock       Boolean            @default(true)
  isActive          Boolean            @default(true)
  metadata          Json?
  businessId        String             @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  stockReservations StockReservation[]

  @@index([businessId])
}

/// تصاویر محصول
model ProductImage {
  id        String   @id @default(uuid()) @db.Char(36)
  url       String
  altText   String?
  position  Int      @default(0)
  metadata  Json?
  productId String   @db.Char(36)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// تصاویر بیزینس
model BusinessImage {
  id         String   @id @default(uuid()) @db.Char(36)
  url        String
  altText    String?
  position   Int      @default(0)
  metadata   Json?
  businessId String   @db.Char(36)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// واریانت محصول (رنگ/سایز و ...)
model ProductVariant {
  id                String             @id @default(uuid()) @db.Char(36)
  sku               String?            @unique
  title             String?
  priceOverride     Decimal?           @db.Decimal(12, 2)
  stockQuantity     Int                @default(0)
  manageStock       Boolean            @default(true)
  metadata          Json?
  productId         String             @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockReservations StockReservation[]

  @@index([productId])
}

/// سفارش
model Order {
  id                String             @id @default(uuid()) @db.Char(36)
  status            String             @default("pending")
  subtotal          Decimal?           @db.Decimal(12, 2)
  shippingAmount    Decimal?           @db.Decimal(12, 2)
  taxAmount         Decimal?           @db.Decimal(12, 2)
  totalAmount       Decimal            @db.Decimal(12, 2)
  currency          String             @default("USD")
  paymentMethod     String?
  paymentStatus     String?
  shippingAddress   Json?
  billingAddress    Json?
  metadata          Json?
  userId            String             @db.Char(36)
  businessId        String?            @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  business          Business?          @relation(fields: [businessId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  items             OrderItem[]
  stockReservations StockReservation[]

  @@index([userId])
  @@index([businessId])
}

/// آیتم‌های سفارش
model OrderItem {
  id         String          @id @default(uuid()) @db.Char(36)
  quantity   Int
  unitPrice  Decimal         @db.Decimal(12, 2)
  totalPrice Decimal         @db.Decimal(12, 2)
  metadata   Json?
  orderId    String          @db.Char(36)
  productId  String          @db.Char(36)
  variantId  String?         @db.Char(36)
  createdAt  DateTime        @default(now())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/// نظرات محصول
model Review {
  id         String   @id @default(uuid()) @db.Char(36)
  rating     Int
  title      String?
  body       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  productId  String   @db.Char(36)
  userId     String   @db.Char(36)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

/// رزرو موجودی
model StockReservation {
  id        String          @id @default(uuid()) @db.Char(36)
  quantity  Int
  status    String          @default("active")
  expiresAt DateTime
  createdAt DateTime        @default(now())
  productId String          @db.Char(36)
  variantId String?         @db.Char(36)
  userId    String          @db.Char(36)
  orderId   String?         @db.Char(36)
  order     Order?          @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([orderId])
}

/// لاگ تغییرات (اختیاری)
model AuditLog {
  id            String   @id @default(uuid()) @db.Char(36)
  entityType    String
  entityId      String   @db.Char(36)
  action        String
  diff          Json?
  createdAt     DateTime @default(now())
  performedById String?  @db.Char(36)
  performedBy   User?    @relation(fields: [performedById], references: [id])
}

model Otp {
  id        String   @id @default(uuid()) @db.Char(36)
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

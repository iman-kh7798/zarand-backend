generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]
}

/// تمام کاربران سیستم
model User {
  id                    String                  @id @default(uuid()) @db.Char(36)
  email                 String?
  passwordHash          String?
  name                  String?
  phone                 String                  @unique
  isActive              Boolean                 @default(true)
  metadata              Json?
  roleId                Int
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  auditLogs             AuditLog[]
  businesses            Business[]
  favoriteBusinesses    FavoriteBusiness[]
  orders                Order[]
  reviews               Review[]
  stockReservations     StockReservation[]
  role                  Role                    @relation(fields: [roleId], references: [id])
  businessReviews       BusinessReview[]
  notifications         NotificationRecipient[]
  createdNotifications  Notification[]          @relation("NotificationCreatedBy")
  approvedNotifications Notification[]          @relation("NotificationApprovedBy")

  @@index([roleId], map: "User_roleId_fkey")
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

/// کسب‌وکار (فروشنده)
model Business {
  id              String               @id @default(uuid()) @db.Char(36)
  title           String
  description     String?
  address         Json?
  phone           String?
  isActive        Boolean              @default(true)
  ownerId         String               @db.Char(36)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  status          BusinessStatus       @default(PENDING)
  imageId         String?              @db.Char(36)
  categoryId      String?              @db.Char(36)
  category        Category?            @relation(fields: [categoryId], references: [id])
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  BusinessImage   BusinessImage[]
  favoritedBy     FavoriteBusiness[]
  orders          Order[]
  products        Product[]
  lat             Decimal?             @db.Decimal(10, 7)
  lng             Decimal?             @db.Decimal(10, 7)
  businessReviews BusinessReview[]
  socialLinks     BusinessSocialLink[]
  reports         BusinessReport[]
  notifications   Notification[]
  /// دلیل رد شدن کسب‌وکار توسط ادمین — در اعلانِ رد برای مالک هم ارسال می‌شود
  statusReason    String?              @db.Text

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@index([categoryId, status])
}

enum SocialPlatform {
  INSTAGRAM
  TELEGRAM
  WHATSAPP
  TWITTER
  LINKEDIN
  FACEBOOK
  YOUTUBE
  WEBSITE
  EITAA
  BALE
  RUBIKA
}

model BusinessSocialLink {
  id         String         @id @default(uuid()) @db.Char(36)
  businessId String         @db.Char(36)
  platform   SocialPlatform
  url        String
  createdAt  DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
  @@index([businessId])
}

/// لیست علاقه‌مندی کسب‌وکارهای کاربران
model FavoriteBusiness {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  businessId String   @db.Char(36)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

/// دسته‌بندی سراسری محصولات (درختی)
model Category {
  id            String     @id @default(uuid()) @db.Char(36)
  name          String
  slug          String     @unique
  description   String?
  isActive      Boolean    @default(true)
  parentId      String?    @db.Char(36)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  coverImageUrl String?
  businesses    Business[]
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToCategory")

  @@index([slug])
  @@index([parentId], map: "Category_parentId_fkey")
}

/// محصول
model Product {
  id                String             @id @default(uuid()) @db.Char(36)
  title             String
  description       String?
  shortDescription  String?
  price             Decimal            @db.Decimal(12, 2)
  compareAtPrice    Decimal?           @db.Decimal(12, 2)
  sku               String?
  stockQuantity     Int                @default(0)
  manageStock       Boolean            @default(true)
  isActive          Boolean            @default(true)
  metadata          Json?
  businessId        String             @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  stockReservations StockReservation[]

  @@index([businessId])
}

/// تصاویر محصول
model ProductImage {
  id        String   @id @default(uuid()) @db.Char(36)
  url       String
  altText   String?
  position  Int      @default(0)
  metadata  Json?
  productId String   @db.Char(36)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "ProductImage_productId_fkey")
}

/// تصاویر بیزینس
model BusinessImage {
  id         String   @id @default(uuid()) @db.Char(36)
  url        String
  altText    String?
  position   Int      @default(0)
  isPrimary  Boolean  @default(false)
  metadata   Json?
  businessId String   @db.Char(36)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "BusinessImage_businessId_fkey")
  @@index([businessId, isPrimary])
}

/// واریانت محصول (رنگ/سایز و ...)
model ProductVariant {
  id                String             @id @default(uuid()) @db.Char(36)
  sku               String?            @unique
  title             String?
  priceOverride     Decimal?           @db.Decimal(12, 2)
  stockQuantity     Int                @default(0)
  metadata          Json?
  productId         String             @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockReservations StockReservation[]

  @@index([productId])
}

/// سفارش
model Order {
  id                String             @id @default(uuid()) @db.Char(36)
  status            String             @default("pending")
  subtotal          Decimal?           @db.Decimal(12, 2)
  shippingAmount    Decimal?           @db.Decimal(12, 2)
  taxAmount         Decimal?           @db.Decimal(12, 2)
  totalAmount       Decimal            @db.Decimal(12, 2)
  currency          String             @default("USD")
  paymentMethod     String?
  paymentStatus     String?
  shippingAddress   Json?
  billingAddress    Json?
  metadata          Json?
  userId            String             @db.Char(36)
  businessId        String?            @db.Char(36)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  business          Business?          @relation(fields: [businessId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  items             OrderItem[]
  stockReservations StockReservation[]

  @@index([userId])
  @@index([businessId])
}

/// آیتم‌های سفارش
model OrderItem {
  id         String          @id @default(uuid()) @db.Char(36)
  quantity   Int
  unitPrice  Decimal         @db.Decimal(12, 2)
  totalPrice Decimal         @db.Decimal(12, 2)
  metadata   Json?
  orderId    String          @db.Char(36)
  productId  String          @db.Char(36)
  variantId  String?         @db.Char(36)
  createdAt  DateTime        @default(now())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/// نظرات محصول
model Review {
  id         String   @id @default(uuid()) @db.Char(36)
  rating     Int
  title      String?
  body       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  productId  String   @db.Char(36)
  userId     String   @db.Char(36)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

/// وضعیت بررسی نظر توسط ادمین/مالک کسب‌وکار برای جلوگیری از اسپم
enum BusinessReviewStatus {
  PENDING // در انتظار بررسی
  APPROVED // تاییدشده — به کاربران عمومی نشان داده می‌شود
  REJECTED // رد شده
}

/// نظرات کسب‌وکار
model BusinessReview {
  id         String               @id @default(uuid()) @db.Char(36)
  rating     Int? // فقط برای نظر ریشه؛ برای پاسخ‌ها null است
  body       String?
  status     BusinessReviewStatus @default(PENDING)
  approvedAt DateTime? // زمان تایید؛ فقط وقتی status = APPROVED مقدار دارد
  createdAt  DateTime             @default(now())
  businessId String               @db.Char(36)
  userId     String               @db.Char(36)
  parentId   String?              @db.Char(36) // اگر مقدار داشته باشد، این نظر یک «پاسخ» است (فقط یک سطح)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])
  parent   BusinessReview?  @relation("BusinessReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  BusinessReview[] @relation("BusinessReviewReplies")

  @@index([businessId])
  @@index([userId])
  @@index([parentId])
  @@index([businessId, status])
  @@index([businessId, parentId, status])
  @@index([status, createdAt])
}

/// رزرو موجودی
model StockReservation {
  id        String          @id @default(uuid()) @db.Char(36)
  quantity  Int
  status    String          @default("active")
  expiresAt DateTime
  createdAt DateTime        @default(now())
  productId String          @db.Char(36)
  variantId String?         @db.Char(36)
  userId    String          @db.Char(36)
  orderId   String?         @db.Char(36)
  order     Order?          @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([orderId])
}

/// لاگ تغییرات (اختیاری)
model AuditLog {
  id            String   @id @default(uuid()) @db.Char(36)
  entityType    String
  entityId      String   @db.Char(36)
  action        String
  diff          Json?
  createdAt     DateTime @default(now())
  performedById String?  @db.Char(36)
  performedBy   User?    @relation(fields: [performedById], references: [id])

  @@index([performedById], map: "AuditLog_performedById_fkey")
}

model Otp {
  id        String   @id @default(uuid()) @db.Char(36)
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

/// پیشنهاد و بازخورد بازدیدکنندگان سایت
model Feedback {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String // نام فرستنده
  contact   String? // راه ارتباطی (تلفن یا ایمیل) — اختیاری
  message   String   @db.Text // متن پیام
  isRead    Boolean  @default(false) // آیا ادمین آن را دیده است
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

/// نوع مشکلی که کاربر برای اطلاعات یک کسب‌وکار گزارش می‌کند
enum BusinessReportType {
  INCORRECT_INFO // اطلاعات نادرست است
  BUSINESS_CLOSED // کسب‌وکار تعطیل شده است
  DUPLICATE // مورد تکراری است
  OTHER // موضوع دیگر
}

/// وضعیت رسیدگی به گزارش
enum BusinessReportStatus {
  PENDING // بررسی‌نشده
  RESOLVED // رسیدگی‌شده
  REJECTED // رد شده
}

/// گزارش «اصلاح اطلاعات» یک کسب‌وکار — فرم عمومی، بدون نیاز به لاگین
model BusinessReport {
  id          String               @id @default(uuid()) @db.Char(36)
  businessId  String               @db.Char(36)
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        BusinessReportType
  description String?              @db.Text // برای «تعطیل شده» و «تکراری» اختیاری است
  status      BusinessReportStatus @default(PENDING)
  isRead      Boolean              @default(false) // آیا ادمین/مالک آن را دیده است
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([businessId, createdAt])
  @@index([status, createdAt])
}

/// نوع اعلان — رویدادی که اعلان را ایجاد کرده است
enum NotificationType {
  BUSINESS_CREATED // کسب‌وکار جدید ثبت شد (برای ادمین)
  BUSINESS_APPROVED // کسب‌وکار تایید شد (برای مالک)
  BUSINESS_REJECTED // کسب‌وکار رد شد (برای مالک، همراه با دلیل)
  REVIEW_CREATED // نظر جدید روی کسب‌وکار (برای مالک — بدون پیامک)
  BUSINESS_REPORT_CREATED // گزارش اصلاح اطلاعات (برای ادمین)
  USER_WELCOME // خوش‌آمدگویی ثبت‌نام
  CUSTOM // اعلان دستی که ادمین یا مالک ساخته است
}

/// مخاطبان اعلان — در زمان ارسال به لیست کاربر تبدیل می‌شود
enum NotificationAudience {
  USERS // فهرست مشخصی از کاربران (userIds)
  ADMINS // همه‌ی ادمین‌ها
  ALL_USERS // همه‌ی کاربران فعال
  BUSINESS_OWNER // مالک یک کسب‌وکار مشخص
  BUSINESS_FAVORITES // کاربرانی که یک کسب‌وکار را نشان کرده‌اند
}

/// وضعیت چرخه‌ی عمر اعلان
enum NotificationStatus {
  PENDING_APPROVAL // ساخته‌ی مالک؛ تا تایید ادمین ارسال نمی‌شود
  REJECTED // ادمین رد کرده — هرگز ارسال نمی‌شود
  QUEUED // تایید شده و در صف پخش
  SENT // گیرنده‌ها ساخته شدند (پیامک‌ها ممکن است هنوز در صف باشند)
  FAILED // پخش با خطا مواجه شد
}

/// وضعیت ارسال پیامک برای هر گیرنده (صف outbox)
enum NotificationSmsStatus {
  NONE // برای این اعلان پیامک درخواست نشده
  PENDING // در صف ارسال
  SENT // ارسال شد
  FAILED // بعد از چند تلاش ناموفق ماند
  SKIPPED // شماره‌ای نبود یا کاربر غیرفعال بود
}

/// یک «اعلان» = یک محتوا + مخاطب؛ توزیع آن در NotificationRecipient ذخیره می‌شود
model Notification {
  id         String               @id @default(uuid()) @db.Char(36)
  type       NotificationType     @default(CUSTOM)
  title      String
  body       String               @db.Text
  audience   NotificationAudience
  status     NotificationStatus   @default(QUEUED)
  sendSms    Boolean              @default(false) // آیا علاوه بر اعلان، پیامک هم برود
  smsText    String?              @db.Text // متن پیامک؛ خالی باشد از title/body ساخته می‌شود
  data       Json? // payload برای لینک‌دهی در کلاینت (مثلاً businessId)
  businessId String?              @db.Char(36) // کسب‌وکار مرتبط (context یا مخاطب)
  business   Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)

  createdById     String?   @db.Char(36) // null یعنی اعلان سیستمی
  createdBy       User?     @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById    String?   @db.Char(36)
  approvedBy      User?     @relation("NotificationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?   @db.Text

  recipientsCount Int       @default(0) // برای گزارش پنل، بدون count روی جدول گیرنده‌ها
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipients NotificationRecipient[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([createdById, createdAt])
  @@index([businessId])
}

/// نسخه‌ی هر کاربر از یک اعلان + وضعیت پیامک همان کاربر (صف ارسال)
model NotificationRecipient {
  id             String       @id @default(uuid()) @db.Char(36)
  notificationId String       @db.Char(36)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String       @db.Char(36)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRead Boolean   @default(false)
  readAt DateTime?

  smsStatus   NotificationSmsStatus @default(NONE)
  smsAttempts Int                   @default(0)
  smsError    String?               @db.Text
  smsSentAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([notificationId, userId])
  // صندوق کاربر و شمارش نخوانده‌ها با همین ایندکس جواب می‌گیرد
  @@index([userId, isRead, createdAt])
  // برداشت دسته‌ای صف پیامک
  @@index([smsStatus, smsAttempts, createdAt])
}
